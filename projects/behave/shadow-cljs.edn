;; shadow-cljs configuration for behave project
;; Uses deps.edn :shadow alias for classpath resolution
{:deps     {:aliases [:shadow]}
 :dev-http {8030 ["target/kaocha-test" "resources/public"]
            ;; SPA fallback: serve index.html for deep worksheet routes
            ;; (e.g. /worksheets/<uuid>/...) so a hard refresh boots the app
            ;; instead of 404ing. The behave clj backend (figwheel's old
            ;; :ring-handler) is not in play under `shadow-cljs server`.
            8040 {:roots            ["target/browser" "resources/public"]
                  :push-state/index "index.html"}}
 :nrepl    {:port       9001
            :middleware [cider.nrepl/cider-middleware]}
 :builds   {:test-kaocha {:target       :browser-test
                          :runner-ns    kaocha.cljs2.shadow-runner
                          :test-dir     "target/kaocha-test"
                          :ns-regexp    "^behave\\..*-test$"
                          :js-options   {:resolve {"datascript-rs"
                                                   {:target :file
                                                    :file   "target/datascript-rs/datascript_rs.js"}}}
                          :compiler-options {:closure-defines
                                            {absurder-sql.datascript.persistent-sorted-set/WASM_URL
                                             "/js/datascript_rs_bg.wasm"}}
                          :build-hooks  [(behave.test-build/wasm-prepare-hook)
                                        (behave.test-build/flush-hook)]
                          :devtools     {:http-port 1819
                                         :http-root "target/kaocha-test"
                                         :preloads  [lambdaisland.chui.remote]}}

            :browser    {:target          :browser
                         :output-dir      "target/browser/js"
                         :asset-path      "/js"
                         :js-options      {:resolve {"datascript-rs"
                                                     {:target :file
                                                      :file   "target/datascript-rs/datascript_rs.js"}}}
                         :compiler-options {:closure-defines
                                           {absurder-sql.datascript.persistent-sorted-set/WASM_URL
                                            "/js/datascript_rs_bg.wasm"
                                            absurder-sql.core/WASM_URL
                                            "/js/datascript_rs_bg.wasm"}}
                         :modules         {:app {:entries [behave.client]}}
                         :build-hooks     [(behave.test-build/wasm-prepare-hook)
                                          (behave.test-build/browser-flush-hook)]
                         ;; re-frame-10x preload removed: 1.9.9 patches reagent's
                         ;; do-render with an arity incompatible with reagent
                         ;; 0.10.0 under React 18, blanking components on a fresh
                         ;; deep-route mount. (figwheel's compile-dev never loaded
                         ;; it.) Re-add once a compatible 10x/reagent combo is set.
                         :devtools        {:preloads [devtools.preload]}
                         :dev             {:compiler-options
                                           {:closure-defines
                                            {re-frame.trace.trace-enabled?        true
                                             day8.re-frame.tracing.trace-enabled? true}}}
                         :release         {:build-options
                                           {:ns-aliases
                                            {day8.re-frame.tracing day8.re-frame.tracing-stubs}}}
                         :closure-defines {re-frame.trace/trace-enabled? true}}

            :app        {:target      :browser
                         :output-dir  "resources/public/cljs"
                         :asset-path  "/cljs"
                         :js-options  {:resolve {"datascript-rs"
                                                 {:target :file
                                                  :file   "target/datascript-rs/datascript_rs.js"}}}
                         :modules     {:app {:entries [behave.client]}}
                         :build-hooks [(behave.test-build/wasm-prepare-hook)
                                       (behave.test-build/app-configure-hook)
                                       (behave.test-build/app-flush-hook)]
                         :compiler-options {:optimizations :advanced
                                            :externs ["resources/behave_externs.js"
                                                      "../../components/absurder_sql/resources/externs.js"]}
                         :release     {:build-options
                                       {:ns-aliases
                                        {day8.re-frame.tracing day8.re-frame.tracing-stubs}}}}}}
