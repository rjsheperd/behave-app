{:source-paths ["src/cljs" "test/cljs"]
 :dev-http     {8080 "public"
                8021 "out/test"}
 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/cljs"
   :asset-path "/cljs"
   :modules
   {:app
    {:init-fn behave-cms.client/init}}}

  :test {:target    :karma
         :output-to "out/karma-tests.js"
         :ns-regexp "^behave-cms\\."
         :autorun   true}}}
