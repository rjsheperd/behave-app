#################################################################
#    Annotation properties
#################################################################

###  http://qudt.org/2.1/schema/qudthasQuantityKind
qudt:hasQuantityKind rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://lod.fs.usda.gov/vocab/hasChild
fsv:hasChild rdf:type owl:ObjectProperty ;
             owl:inverseOf fsv:hasParent ;
             rdfs:label "has Child"@en .


###  http://lod.fs.usda.gov/vocab/hasGroup
fsv:hasGroup rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf fsv:hasChild ;
             owl:inverseOf fsv:hasParentGroup ;
             rdfs:domain fsv:Group ,
                         fsv:Submodule ;
             rdfs:range fsv:Group ,
                        fsv:Submodule ;
             rdfs:comment "Allows groups to nest within submodules & groups."@en ;
             rdfs:label "has Group"@en .


###  http://lod.fs.usda.gov/vocab/hasModule
fsv:hasModule rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf fsv:hasParent ;
              owl:inverseOf fsv:hasSubmodule ;
              rdf:type owl:TransitiveProperty .


###  http://lod.fs.usda.gov/vocab/hasParent
fsv:hasParent rdf:type owl:ObjectProperty ;
              rdfs:label "has Parent"@en .


###  http://lod.fs.usda.gov/vocab/hasParentGroup
fsv:hasParentGroup rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf fsv:hasParent .


###  http://lod.fs.usda.gov/vocab/hasSubmodule
fsv:hasSubmodule rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf fsv:hasChild ;
                 rdfs:domain fsv:Module ;
                 rdfs:range fsv:Submodule ;
                 rdfs:comment "Allows submodules to nest within a module."@en ;
                 rdfs:label "has Submodule" .


#################################################################
#    Classes
#################################################################

###  http://lod.fs.usda.gov/vocab/Concept
fsv:Concept rdf:type owl:Class ;
            rdfs:comment "A 'Concept' specific to the Forest Service domain."@en ;
            rdfs:label "Concept"@en .


###  http://lod.fs.usda.gov/vocab/ContinuousVariable
fsv:ContinuousVariable rdf:type owl:Class ;
                       rdfs:subClassOf fsv:Variable ;
                       rdfs:comment "'Continuous Variable' specific to the Forest Service domain."@en ;
                       rdfs:label "Continuous Variable" .


###  http://lod.fs.usda.gov/vocab/DiscreteVariable
fsv:DiscreteVariable rdf:type owl:Class ;
                     rdfs:subClassOf fsv:Variable ;
                     rdfs:comment "'Discrete Variable' is a property that has a discrete set of values which specific to the Forest Service domain."@en ;
                     rdfs:label "Discrete Variable" .


###  http://lod.fs.usda.gov/vocab/Group
fsv:Group rdf:type owl:Class ;
          rdfs:subClassOf fsv:Concept ;
          rdfs:label "Group"@en .


###  http://lod.fs.usda.gov/vocab/Module
fsv:Module rdf:type owl:Class ;
           rdfs:subClassOf fsv:Concept ;
           rdfs:comment "'Module' which groups multiple 'Submodules' domain."@en ;
           rdfs:label "Module"@en .


###  http://lod.fs.usda.gov/vocab/Submodule
fsv:Submodule rdf:type owl:Class ;
              rdfs:subClassOf fsv:Concept ;
              rdfs:comment "A 'Submodule' is nested inside of a 'Module' and can have multiple 'Groups' nested under it."@en ;
              rdfs:label "Submodule"@en .


###  http://lod.fs.usda.gov/vocab/TextVariable
fsv:TextVariable rdf:type owl:Class ;
                 rdfs:subClassOf fsv:Variable ;
                 rdfs:comment "'Text Variable' specific to the Forest Service domain."@en ;
                 rdfs:label "Text Variable" .


###  http://lod.fs.usda.gov/vocab/Variable
fsv:Variable rdf:type owl:Class ;
             rdfs:subClassOf fsv:Concept ;
             rdfs:comment "A 'Variable' specific to the Forest Service domain."@en ;
             rdfs:label "Variable" ,
                        "Variable"@en .

